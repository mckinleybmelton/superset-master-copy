# Copy to .env.factory (gitignored) or let scripts/setup-factory.sh write it.

# Product repo the implementer opens PRs against (this Superset fork).
FACTORY_PRODUCT_REPO=mckinleybmelton/superset-master-copy
FACTORY_PRODUCT_DEFAULT_BRANCH=master
# FACTORY_PRODUCT_REPO_PATH=/absolute/path/to/this/checkout

# Optional: limit backlog triage to issues with this label
# FACTORY_ISSUE_LABEL=factory

# Set to 1 when signed in / on hosted deploy so implementer+reviewer
# receive GitHub cursorAccount events (requires agent-sdk login).
# FACTORY_GITHUB_CURSOR_EVENTS=1
